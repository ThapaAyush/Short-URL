# Server Environment
NODE_ENV=production

# Server Port (Render sets this dynamically; defaults to 8001 locally)
PORT=8001

# MongoDB Connection String (MongoDB Atlas URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/short-url?appName=Cluster0

# Secret key used to sign login sessions & JWT tokens (Required in production)
JWT_SECRET=replace-with-a-long-random-string

# Optional: Public address shown for short links (e.g., https://your-service.onrender.com)
# Defaults dynamically to the incoming request host if not set.
BASE_URL=https://short-url.onrender.com
