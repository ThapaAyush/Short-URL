<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f6f4ef">
    <title>Linkboard | URL workspace</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
        :root { --ink:#16252b; --muted:#66757a; --line:#dce2dd; --paper:#f6f4ef; --panel:#fffefa; --teal:#0d6b68; --teal-dark:#084c4a; --coral:#e87857; --yellow:#f5ca65; --shadow:0 18px 60px rgba(22,37,43,.08); }
        * { box-sizing:border-box; }
        body { margin:0; color:var(--ink); background-color:var(--paper); background-image:linear-gradient(rgba(13,107,104,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(13,107,104,.035) 1px,transparent 1px); background-size:32px 32px; font-family:'DM Sans',sans-serif; }
        a { color:inherit; }
        .shell { min-height:100vh; padding:26px 5vw 56px; }
        .topbar { align-items:center; display:flex; justify-content:space-between; margin:0 auto 58px; max-width:1180px; }
        .brand { align-items:center; display:flex; gap:11px; text-decoration:none; }
        .brand-mark { align-items:center; background:var(--teal); border-radius:9px; color:white; display:flex; font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:700; height:36px; justify-content:center; transform:rotate(-8deg); width:36px; }
        .brand-name { font-family:'Space Grotesk',sans-serif; font-size:19px; font-weight:700; letter-spacing:-.5px; }
        .brand-name span { color:var(--coral); }
        .account { align-items:center; display:flex; gap:12px; }
        .avatar { align-items:center; background:var(--yellow); border:2px solid var(--ink); border-radius:50%; display:flex; font-family:'Space Grotesk',sans-serif; font-size:13px; font-weight:700; height:35px; justify-content:center; width:35px; }
        .account-copy { display:grid; gap:2px; }
        .account-name { font-size:13px; font-weight:700; }
        .account-role { color:var(--muted); font-size:11px; letter-spacing:.08em; text-transform:uppercase; }
        .content { margin:0 auto; max-width:1180px; }
        .eyebrow { color:var(--teal); font-size:12px; font-weight:700; letter-spacing:.16em; margin:0 0 13px; text-transform:uppercase; }
        h1 { font-family:'Space Grotesk',sans-serif; font-size:clamp(36px,5vw,64px); letter-spacing:-3px; line-height:.98; margin:0; max-width:690px; }
        .intro { color:var(--muted); font-size:16px; line-height:1.6; margin:20px 0 33px; max-width:540px; }
        .composer { background:var(--teal-dark); box-shadow:var(--shadow); color:white; display:grid; gap:20px; padding:28px; position:relative; }
        .composer:after { border:1px solid rgba(255,255,255,.2); content:''; height:60px; position:absolute; right:20px; top:20px; transform:rotate(12deg); width:60px; }
        .composer-copy,.composer-form { position:relative; z-index:1; }
        .composer-title { font-family:'Space Grotesk',sans-serif; font-size:21px; font-weight:600; margin:0 0 6px; }
        .composer-note { color:#b9d8d3; font-size:13px; margin:0; }
        .composer-form { align-items:center; display:flex; gap:8px; }
        .composer-form input { background:white; border:0; border-radius:4px; color:var(--ink); flex:1; font:inherit; min-height:50px; outline:0; padding:0 16px; }
        .composer-form input:focus { box-shadow:0 0 0 3px rgba(245,202,101,.6); }
        .button { border:0; cursor:pointer; font:700 14px 'DM Sans',sans-serif; min-height:50px; padding:0 22px; }
        .button-primary { background:var(--coral); color:white; }
        .button-primary:hover { background:#d96343; }
        .notice { align-items:center; background:#fff8df; border-left:4px solid var(--yellow); display:flex; gap:12px; margin-top:18px; padding:14px 16px; }
        .notice strong { font-size:13px; }
        .notice a { color:var(--teal); }
        .notice .copy { margin-left:auto; }
        .stats { display:grid; gap:14px; grid-template-columns:repeat(3,1fr); margin:38px 0 52px; }
        .stat { background:rgba(255,254,250,.8); border-top:2px solid var(--teal); padding:18px 19px; }
        .stat:nth-child(2) { border-color:var(--coral); }
        .stat:nth-child(3) { border-color:var(--yellow); }
        .stat-label { color:var(--muted); font-size:12px; letter-spacing:.09em; text-transform:uppercase; }
        .stat-value { display:block; font-family:'Space Grotesk',sans-serif; font-size:31px; margin-top:8px; }
        .section-heading { align-items:end; display:flex; justify-content:space-between; margin-bottom:17px; }
        .section-heading h2 { font-family:'Space Grotesk',sans-serif; font-size:25px; letter-spacing:-.8px; margin:0; }
        .section-heading p { color:var(--muted); font-size:13px; margin:0; }
        .table-wrap { background:var(--panel); border:1px solid var(--line); box-shadow:0 8px 30px rgba(22,37,43,.04); overflow-x:auto; }
        table { border-collapse:collapse; min-width:720px; width:100%; }
        th { background:#f0f4ef; color:var(--muted); font-size:11px; letter-spacing:.1em; padding:15px 18px; text-align:left; text-transform:uppercase; }
        td { border-top:1px solid var(--line); font-size:14px; padding:18px; vertical-align:middle; }
        .number { color:#98a4a2; font-family:'Space Grotesk',sans-serif; width:65px; }
        .short-link { align-items:center; color:var(--teal); display:inline-flex; font-family:'Space Grotesk',sans-serif; font-weight:700; gap:7px; text-decoration:none; }
        .short-link:before { background:var(--yellow); border-radius:50%; content:''; height:7px; width:7px; }
        .redirect { color:var(--muted); max-width:370px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .clicks { font-family:'Space Grotesk',sans-serif; font-weight:700; }
        .copy { background:transparent; border:1px solid var(--line); color:var(--muted); cursor:pointer; font:600 11px 'DM Sans',sans-serif; padding:5px 8px; }
        .copy:hover { border-color:var(--teal); color:var(--teal); }
        .empty { color:var(--muted); padding:32px 18px; text-align:center; }
        @media (max-width:680px) { .shell{padding:20px 18px 42px}.topbar{margin-bottom:42px}.account-copy{display:none}h1{letter-spacing:-2px}.composer{padding:22px 18px}.composer-form{align-items:stretch;flex-direction:column}.composer-form input,.button{width:100%}.stats{grid-template-columns:1fr;margin:27px 0 38px}.section-heading{align-items:start;flex-direction:column;gap:7px}.notice{align-items:start;flex-direction:column}.notice .copy{margin-left:0} }
    </style>
 </head>

<body>
    <% const entries = urls || []; const totalClicks = entries.reduce((sum, item) => sum + item.visitHistory.length, 0); const displayName = user && user.name ? user.name : 'Workspace member'; const initials = displayName.slice(0, 1).toUpperCase(); %>
    <div class="shell">
        <header class="topbar">
            <a class="brand" href="/"><span class="brand-mark">L</span><span class="brand-name">link<span>board</span></span></a>
            <div class="account"><span class="avatar"><%= initials %></span><span class="account-copy"><span class="account-name"><%= displayName %></span><span class="account-role"><%= user && user.role ? user.role : 'NORMAL' %> access</span></span></div>
        </header>

        <main class="content">
            <p class="eyebrow">Your link workspace</p>
            <h1>Make every link count.</h1>
            <p class="intro">Create clean, memorable short links and keep a clear eye on how they travel.</p>

            <section class="composer">
                <div class="composer-copy"><p class="composer-title">Shorten a new URL</p><p class="composer-note">Paste the long version. We will handle the rest.</p></div>
                <form class="composer-form" method="POST" action="/url"><input type="url" name="url" placeholder="https://your-next-destination.com" required><button class="button button-primary" type="submit">Create link</button></form>
            </section>

            <% if (locals.id) { %>
                <div class="notice"><strong>Your new link is ready: <a href="/<%= id %>">localhost:8001/<%= id %></a></strong><button class="copy" data-copy="http://localhost:8001/<%= id %>" type="button">Copy link</button></div>
            <% } %>

            <section class="stats" aria-label="Link statistics">
                <div class="stat"><span class="stat-label">Total links</span><strong class="stat-value"><%= entries.length %></strong></div>
                <div class="stat"><span class="stat-label">Total clicks</span><strong class="stat-value"><%= totalClicks %></strong></div>
                <div class="stat"><span class="stat-label">Workspace</span><strong class="stat-value"><%= user && user.role === 'ADMIN' ? 'All' : 'Personal' %></strong></div>
            </section>

            <section>
                <div class="section-heading"><h2><%= user && user.role === 'ADMIN' ? 'All workspace links' : 'Your recent links' %></h2><p><%= entries.length ? 'Updated as people click.' : 'Your link collection is waiting.' %></p></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>#</th><th>Short link</th><th>Destination</th><th>Clicks</th><th></th></tr></thead>
                        <tbody>
                            <% if (entries.length) { %>
                                <% entries.forEach((url, index) => { %>
                                    <tr><td class="number"><%= String(index + 1).padStart(2, '0') %></td><td><a class="short-link" href="/<%= url.shortId %>"><%= url.shortId %></a></td><td class="redirect" title="<%= url.redirectURL %>"><%= url.redirectURL %></td><td class="clicks"><%= url.visitHistory.length %></td><td><button class="copy" data-copy="http://localhost:8001/<%= url.shortId %>" type="button">Copy</button></td></tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td class="empty" colspan="5">No links yet. Your first one can start here.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
    <script>
        document.querySelectorAll('[data-copy]').forEach(function (button) { button.addEventListener('click', function () { navigator.clipboard.writeText(button.dataset.copy).then(function () { const originalText = button.textContent; button.textContent = 'Copied'; setTimeout(function () { button.textContent = originalText; }, 1400); }); }); });
    </script>
</body>

</html>
